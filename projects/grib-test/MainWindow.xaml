<Window x:Class="ArduinoDataLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Arduino Data Logger" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <ComboBox x:Name="cmbPorts" Width="120" Margin="5"/>
            <ComboBox x:Name="cmbBaudRate" Width="80" Margin="5" SelectedIndex="4">
                <ComboBoxItem>300</ComboBoxItem>
                <ComboBoxItem>600</ComboBoxItem>
                <ComboBoxItem>1200</ComboBoxItem>
                <ComboBoxItem>2400</ComboBoxItem>
                <ComboBoxItem>9600</ComboBoxItem>
                <ComboBoxItem>14400</ComboBoxItem>
                <ComboBoxItem>19200</ComboBoxItem>
                <ComboBoxItem>38400</ComboBoxItem>
                <ComboBoxItem>57600</ComboBoxItem>
                <ComboBoxItem>115200</ComboBoxItem>
            </ComboBox>
            <Button x:Name="btnConnect" Content="Подключить" Width="100" Margin="5" Click="BtnConnect_Click"/>
            <Button x:Name="btnDisconnect" Content="Отключить" Width="100" Margin="5" Click="BtnDisconnect_Click" IsEnabled="False"/>
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Margin="5" Click="BtnSave_Click"/>
            <Button x:Name="btnSaveAs" Content="Сохранить как..." Width="100" Margin="5" Click="BtnSaveAs_Click"/>
            <TextBlock x:Name="tbStatus" Margin="5" VerticalAlignment="Center" Text="Готово"/>
        </StackPanel>

        <!-- График -->
        <lvc:CartesianChart Grid.Row="1" Margin="10" Series="{Binding Series}" LegendLocation="Right">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Время (мм:сс)" LabelFormatter="{Binding TimeFormatter}">
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="10"/>
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Значение" LabelFormatter="{Binding ValueFormatter}"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- Лог -->
        <TextBox Grid.Row="2" x:Name="tbLog" Height="100" Margin="10" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"/>
    </Grid>
</Window>